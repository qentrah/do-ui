{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "declaration": true, "outDir": "dist", "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["dist", "node_modules"]
}
