{
  "name": "@qentrah/do-ui-docs",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8091",
    "web": "expo start --web --port 8091",
    "ios": "expo start --ios --port 8091",
    "android": "expo start --android --port 8091",
    "build:web": "pnpm docs:generate && expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "preview": "node scripts/serve.cjs",
    "docs:generate": "node scripts/generate-docs.cjs",
    "test": "node --test tests/*.test.cjs",
    "docs:validate": "node scripts/validate-docs.cjs"
  },
  "dependencies": {
    "@qentrah/do-ui": "workspace:*",
    "expo": "54.0.37",
    "expo-router": "6.0.24",
    "expo-font": "14.0.12",
    "expo-status-bar": "3.0.9",
    "expo-linking": "8.0.12",
    "expo-constants": "18.0.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.4",
    "react-native-svg": "15.12.1",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-webview": "13.15.0",
    "@expo/vector-icons": "15.1.1",
    "nativewind": "5.0.0-preview.3",
    "react-native-css": "3.0.7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.1.17",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "@tailwindcss/postcss": "4.3.3"
  }
}
