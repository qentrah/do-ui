{
  "name": "do-ui-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm --filter @qentrah/do-ui build && pnpm --filter @qentrah/do-ui-docs build:web",
    "dev": "pnpm --filter @qentrah/do-ui-docs web",
    "check": "pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm --filter @qentrah/do-ui-docs docs:validate"
  }
}
